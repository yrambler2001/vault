# ──────────────────────────────────────────────────────────────────
# Secure Vault — Backend Configuration
# ──────────────────────────────────────────────────────────────────
#
# ⚠️  HTTPS IS REQUIRED — HTTP IS NOT SUPPORTED
#
# This application requires HTTPS at all times, including development.
# Session cookies are set with secure:true, WebAuthn requires a
# secure context, and Web Crypto API is unavailable over HTTP.
# The server will REFUSE TO START without valid TLS certificates.
#
# ⚠️  SESSIONS ARE IN-MEMORY ONLY
#
# All sessions are stored in server memory. A server restart will
# terminate ALL active sessions. Users must re-authenticate after
# restart. This is by design — no session data is persisted to disk.
#
# ──────────────────────────────────────────────────────────────────

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS — set to your frontend URL (must include protocol)
FRONTEND_URL=https://localhost:5173

# TLS (REQUIRED — app will not start without these)
# For development, use self-signed certs:
#   openssl req -x509 -newkey rsa:2048 -keyout certs/key.pem \
#     -out certs/cert.pem -days 365 -nodes -subj "/CN=localhost"
# For production, use Let's Encrypt or similar.
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem

# Debug logging
DEBUG=false

# Session timeout in minutes (default 30)
# Sessions are stored in memory only — server restart clears all sessions.
SESSION_TIMEOUT_MINUTES=30

# Max concurrent sessions (default 5)
MAX_SESSIONS=5

# Max local version history files to keep (minimum 5)
MAX_LOCAL_VERSIONS=50

# Cookie settings
# Set to your domain in production. Use "localhost" for dev.
COOKIE_DOMAIN=localhost

# WebAuthn Relying Party ID
# Use "localhost" for local dev. Use your domain for production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Secure Vault
# The full origin (protocol + host + port) — required for WebAuthn verification
WEBAUTHN_ORIGIN=https://localhost:5173

# ── Reverse Proxy Configuration ──
# If behind a reverse proxy (nginx, Cloudflare, Tailscale, etc.),
# set this to the number of trusted proxies so that rate limiting
# uses the real client IP instead of the proxy IP.
#   0 or false = no proxy (direct connection) — DEFAULT
#   1          = one proxy (e.g., nginx on same host)
#   2          = two proxies (e.g., Cloudflare → nginx)
#   loopback   = trust loopback addresses only
#
# WARNING: If behind a proxy and this is NOT set, rate limiting will
# treat all requests as from the proxy IP, making limits ineffective.
TRUST_PROXY=0

# ── USB Backup Drives ──
# Comma-separated list of drive backup directories.
# Each entry is label:path — the path is the FOLDER where vault versions are stored.
# Examples:
#   Windows: USB1:E:\secure-vault,USB2:F:\secure-vault,USB3:G:\secure-vault
#   Linux:   USB1:/mnt/usb1/secure-vault,USB2:/mnt/usb2/secure-vault
# The app will NOT auto-detect drives. Only pre-configured paths are used.
# Paths must NOT be filesystem roots. Paths containing ".." are rejected.
# Duplicate paths are rejected at startup.
VAULT_DRIVES=

# Auto-lock timeout in minutes for frontend vault (default 5)
AUTO_LOCK_MINUTES=5

# Global rate limit: max requests per second per IP (default 10)
GLOBAL_RATE_LIMIT_PER_SECOND=10